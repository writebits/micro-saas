# Chave da API da OpenAI. Se vazio, a aplicação usa um fallback determinístico
# (útil para desenvolvimento e para gravar a demo sem gastar créditos).
OPENAI_API_KEY=

# Modelo usado para gerar os insights.
OPENAI_MODEL=gpt-4o-mini

# Nome padrão da agência quando não informado no upload.
DEFAULT_AGENCY_NAME=Sua Agência de Tráfego

# Nome do produto exibido na interface/título.
APP_NAME=TrafficReport AI

# Quantidade máxima de relatórios mantidos em memória.
REPORT_TTL_ITEMS=200
